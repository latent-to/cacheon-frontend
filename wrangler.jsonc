{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cacheon-frontend",
  "compatibility_date": "2026-04-20",
  "main": "./workers/app.ts",
  "vars": {
    "CACHEON_PRICING": {
      "qwen": { "input": null, "output": null, "cacheRead": null },
      "glm": { "input": null, "output": null, "cacheRead": null },
      "deepseek": { "input": null, "output": null, "cacheRead": null }
    }
  },
  "send_email": [{ "name": "SALES_EMAIL", "destination_address": "sales@cacheon.ai" }],
  "ratelimits": [
    {
      "name": "CONTACT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  "observability": {
    "enabled": true
  },
  "compatibility_flags": ["nodejs_compat"]
}
